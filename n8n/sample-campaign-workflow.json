{
  "name": "Sample Campaign Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-campaign",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Campaign Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.body.testMode }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        }
      },
      "id": "test-mode",
      "name": "Test Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://example.invalid/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $json.body.to, type: 'template' } }}"
      },
      "id": "api-call",
      "name": "External Messaging API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, mode: $json.body?.testMode ? 'test' : 'live-example' } }}"
      },
      "id": "response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Campaign Webhook": {
      "main": [[{ "node": "Test Mode?", "type": "main", "index": 0 }]]
    },
    "Test Mode?": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }],
        [{ "node": "External Messaging API", "type": "main", "index": 0 }]
      ]
    },
    "External Messaging API": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {},
  "meta": {
    "portfolio": true,
    "note": "Sanitized educational workflow. No production credentials or customer data."
  },
  "active": false,
  "versionId": "portfolio-sample"
}
